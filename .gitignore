!/jarvis_health.py
!/jarvis_settings.py
!/jarvis_install.py
!/jarvis_probe.py
!/jarvis_setup.py
!/jarvis_distribution_launcher.cs
!/SetupJarvis.cmd
!/StartJarvis.cmd
!/CheckJarvis.cmd
!/INSTALL.md
!/jarvis_interactive_launcher.cs
!/jarvis_startup_hologram.cs
!/jarvis_mask_overlay.py
!/render_mask_preview.py
!/jarvis_overlay.py
!/jarvis_skills.py
!/jarvis_wake_listener.py
!/local_llm.py
!/main.py
!/openai_chat.py
!/screen_vision.py
!/task_store.py
!/wechat_desktop_bridge.py
!/wechat_login_qr.py
!/upgrade_ui.js
!/generate_speech_cache.ps1
!/start_jarvis.ps1
!/start_jarvis_desktop.ps1
!/test_*.py
!/test_upgrade_ui.cjs
!/CODEX_INTEGRATION_README.md
!/DESKTOP_VOICE_README.md
!/SKILLS_README.md
!/UPGRADE_PROGRESS.md
!/assets/
/assets/*
!/assets/SOURCE.md
!/assets/ironman-mask-full.png
!/assets/jarvis-cinematic-hologram-v2.png
!/assets/jarvis-cinematic-hologram-v2.prompt.md
!/previews/
/previews/*
!/previews/jarvis-cinematic-startup-v2.mp4
!/previews/jarvis-mask-wake.mp4

# Defense in depth, even if the source allowlist is later expanded.
**/.env
**/.env.*
**/*.env
**/*.env.*
**/*credential*
**/*secret*
**/*.pem
**/*.key
**/__pycache__/
**/*.py[cod]
**/*.sqlite*
**/*.db
**/*.log
**/*.log.*
**/*.wav
**/*.mp3
**/*.exe
**/*.dll
/.venv/
/.voice-venv/
/runtime/
/logs/
/speech_cache/
/backups*/
/tmp*/
/jarvis.local.json
/.jarvis-install-pending
/.jarvis-settings-*
/projects/
